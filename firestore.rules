rules_version = '2';

// ---------------------------------------------------------------------------
// Marudhara Exam — Production Firestore Security Rules
// ---------------------------------------------------------------------------
// Deploy with:  firebase deploy --only firestore:rules
// (or paste this file's contents into Firebase Console -> Firestore ->
// Rules -> Publish).
//
// This replaces the default "allow read, write: if true" test-mode rules
// (the cause of the Firestore Console security warning) with a real,
// least-privilege policy:
//
//   - Site content (exams, vacancies, notes, mock tests, results, etc.)
//     is publicly READABLE, exactly like today, so the public website
//     keeps working with zero UI changes.
//   - Only a signed-in admin account (see ADMIN_EMAILS below) may create,
//     update, or delete that content.
//   - Students may CREATE their own mock-test attempt records (no auth
//     required, matching the current no-login exam flow) but can never
//     modify or delete an attempt once submitted.
//   - Payment/purchase data (paymentOrders, userCategoryAccess) is
//     managed exclusively by the Cloudflare Worker using a service
//     account, which authenticates via Google OAuth2 and therefore
//     bypasses these rules entirely — so it is deliberately locked to
//     "deny all" here for every normal client, preventing anyone from
//     reading or forging purchase/payment records from the browser.
//   - Everything not explicitly listed below is denied by default.
//
// IMPORTANT: keep ADMIN_EMAILS below in sync with admin-auth.js.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          'jmdseller2025@gmail.com'
        ];
    }

    // ------------------------------------------------------------------
    // Public site content — public read, admin-only write.
    // ------------------------------------------------------------------
    match /exams/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vacancies/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /downloads/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notesCategories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notesSubjects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notesTopics/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notesPdfs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offerBanners/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizzes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Topic-wise Quiz feature (Quiz Section: Subject -> Topic -> Questions).
    match /quizSubjects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizTopics/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizQuestions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizSets/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dailySujas/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /monthlySujasMcq/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /news/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Government exam result PDFs/metadata (result-admin.html).
    match /results/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Result search system (result-system/).
    match /resultExams/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resultStudents/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Preparation Exam master (My Preparation feature) — a SEPARATE exam
    // catalog from /exams above, managed only via the "🎯 Preparation
    // Exams" section in the existing Admin Panel (admin-v2.html). Public/
    // students may only read exams the admin has marked Active; drafts/
    // inactive exams stay invisible to students, same rule shape as
    // typingTests below. Only the allow-listed admin (isAdmin()) may
    // create, update, or delete entries.
    // ------------------------------------------------------------------
    match /preparationExams/{docId} {
      allow read: if isAdmin() || resource.data.status in ['Active', 'active', 'ACTIVE'] || resource.data.isActive == true;
      allow create, update, delete: if isAdmin();
    }

    // Exam structure (Subject -> Chapter -> Topic), managed only from the
    // "🎯 Preparation Exams" admin section. Public/student read (same as
    // quizSubjects/quizTopics below) so the syllabus tree can render for
    // any student who has selected the exam; only admin may write.
    match /preparationSubjects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /preparationChapters/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /preparationTopics/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-curated links from existing content (MCQ topics, PYQ papers,
    // notes, mock categories) to a preparation exam/subject/chapter/topic.
    // Public/student read, admin-only write.
    match /preparationMappings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lightweight aggregate counters per exam (e.g. how many students have
    // selected it) shown in the admin analytics tile. Publicly readable
    // (contains no personal student data); any signed-in student may only
    // touch the counter fields when they select/remove the exam, never
    // rewrite the whole document.
    match /preparationExamStats/{docId} {
      allow read: if true;
      // The counter doc is created lazily by the first student who selects
      // the exam (via setDoc merge), so create must be allowed for any
      // signed-in student too - but only with exactly the counter fields,
      // never arbitrary data.
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['selectedCount', 'updatedAt']) &&
        request.resource.data.selectedCount is int &&
        request.resource.data.selectedCount == 1;
      // Permit only a one-step counter change per request; do not let a client
      // overwrite the aggregate with an arbitrary number. Admin can repair it.
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['selectedCount', 'updatedAt']) &&
        request.resource.data.selectedCount is int &&
        resource.data.selectedCount is int &&
        (request.resource.data.selectedCount == resource.data.selectedCount + 1 ||
         request.resource.data.selectedCount == resource.data.selectedCount - 1) &&
        request.resource.data.selectedCount >= 0;
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Mock test system — public read, admin-only write.
    // ------------------------------------------------------------------
    match /mockCategories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mockSubCategories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mockTests/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mockQuestions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Typing Test Manager (typing-admin.html).
    // Admin: full read/create/update/delete.
    // Public/students: read allowed only for content the admin has
    // actually published and marked active — drafts/inactive/removed
    // items stay invisible to anyone who isn't signed in as admin.
    // ------------------------------------------------------------------
    match /typingTests/{docId} {
      allow read: if isAdmin() ||
        (resource.data.status == 'published' && resource.data.isActive == true);
      allow create, update, delete: if isAdmin();
    }

    match /typingTestSeries/{docId} {
      allow read: if isAdmin() ||
        (resource.data.status == 'published' && resource.data.isActive == true);
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Student-submitted exam attempts — anyone may create their own
    // attempt (site has no login for students), nobody may edit/delete
    // one after submission. Read stays public because result.html uses
    // a live collection query to compute each student's overall rank.
    // ------------------------------------------------------------------
    match /mockResults/{docId} {
      allow read: if true;
      allow create: if request.resource.data.mockId is string
        && request.resource.data.score is number
        // My Preparation bridge: studentUid is optional (old clients / logged-out
        // flows omit it or send ""), but if present it must be the signer's own
        // uid, so nobody can attribute a result to another student's UID.
        && (!('studentUid' in request.resource.data)
            || request.resource.data.studentUid == ''
            || (request.auth != null && request.auth.uid == request.resource.data.studentUid));
      allow update, delete: if isAdmin();
    }

    match /examAttempts/{docId} {
      allow read: if true;
      allow create: if request.resource.data.mockId is string;
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Payment data — the Cloudflare payments Worker writes/reads this
    // exclusively via a service account (Google OAuth2), which is NOT
    // subject to these rules. No browser client should ever touch these
    // collections directly, so they are fully locked down here.
    // ------------------------------------------------------------------
    match /paymentOrders/{docId} {
      allow read, write: if false;
    }

    match /userCategoryAccess/{docId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Student accounts — Firebase Phone Authentication (OTP) login.
    // A signed-in student may read/write ONLY their own profile document,
    // keyed by their Firebase Auth uid (users/{uid}: uid, name, mobile,
    // createdAt, lastLogin). No other student or anonymous visitor can
    // read or modify another student's profile.
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // My Preparation (Phase 1) — studentPreparations/{uid}: one document
    // per student, keyed by the SAME Firebase Auth uid used by users/{uid}
    // above. A signed-in student may read/write ONLY their own document;
    // no student can ever see or modify another student's selected
    // exams/preparation data.
    // ------------------------------------------------------------------
    match /studentPreparations/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Per-student, per-exam preparation activity: topic completion status,
    // MCQ/PYQ/Mock/Notes activity log, study-planner tasks, and revision
    // flags. All stored as subcollections UNDER the student's own
    // studentPreparations/{uid} document (same uid as above) so a single
    // rule keeps every one of them owner-only and nothing ever needs a
    // separate "does this activity belong to me" check.
    match /studentPreparations/{uid}/{subcollection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // Everything else: denied by default (no more open test-mode rules).
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
